# GNews key — get one free at https://gnews.io/ (100 req/day)
VITE_GNEWS=your_gnews_key_here
# RapidAPI Cricket (Cricbuzz) — https://rapidapi.com/cricketapilive/api/cricbuzz-cricket
# Get a key at https://rapidapi.com/ → subscribe → copy X-RapidAPI-Key
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_CRICKET_HOST=cricbuzz-cricket.p.rapidapi.com
# API-Football — https://dashboard.api-football.com/ (100 req/day free)
# Sent as x-apisports-key header via Vite proxy so it never ships to client in dev
VITE_FOOTBALL=your_api_football_key_here
